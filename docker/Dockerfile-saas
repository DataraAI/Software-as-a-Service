FROM python:3.12-slim AS base

ENV PYTHONUNBUFFERED=1 \
    PIP_NO_CACHE_DIR=1 \
    PYTHONDONTWRITEBYTECODE=1

WORKDIR /app

# Development — live-mounted workspace, interactive use
FROM base AS development

COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

COPY . .

CMD ["sleep", "infinity"]

# Production — slim runtime for batch/cron or long-running workers
FROM base AS production

COPY requirements-docker.txt .
RUN pip install --no-cache-dir -r requirements-docker.txt

COPY . .

HEALTHCHECK --interval=30s --timeout=10s --start-period=15s --retries=3 \
    CMD python -c "from datara_client import DataraAPIClient; DataraAPIClient().health()" || exit 1

CMD ["python", "-c", "from datara_client import DataraAPIClient; c=DataraAPIClient(); print(c.health())"]
