# Use HTTPS for staging/production. HTTP is acceptable only for localhost testing.
DAAS_INTERNAL_API_URL=https://staging.example.com
GENERATION_WORKER_TOKEN=replace-with-the-same-long-random-token-as-daas
CELERY_BROKER_URL=amqp://saas-worker:replace-with-a-url-safe-worker-password@10.0.0.4:5672/datara

# Optional overrides. Defaults are lambda_jobs, 30, and 1800.
# CELERY_QUEUE_NAME=lambda_jobs
# WORKER_HTTP_TIMEOUT_SECONDS=30
# WORKER_LONG_REQUEST_TIMEOUT_SECONDS=1800
